-- Q01. Active driver headcount.
SELECT COUNT(*) AS active_driver_count
FROM driver
WHERE left_date IS NULL;

-- Q02. Total platform GMV.
SELECT SUM(amount) AS total_gmv_eur    
FROM payment
WHERE TRIM(LOWER(status)) = 'succeeded';

-- Q03. Total refund exposure.
SELECT SUM(amount) AS total_refunded_eur
FROM payment
WHERE TRIM(LOWER(status)) = 'refunded';

-- Q04. Customer base split.
SELECT TOP 5 customer_type, COUNT(*) AS customer_count
FROM customer
GROUP BY customer_type
ORDER BY customer_type ASC;

-- Q05. Voucher pool size.
SELECT COUNT(DISTINCT rider_customer_id) AS voucher_eligible_customer_count
FROM trip
WHERE TRIM(LOWER(status)) IN ('cancelled_by_rider', 'cancelled_by_driver', 'aborted', 'no_show', 'noshow');

-- Q06. Busiest pickup zones.
SELECT TOP 10 z.zone_name, COUNT(*) AS trip_count
FROM trip t
JOIN zone z ON t.pickup_zone_id = z.zone_id
GROUP BY z.zone_name
ORDER BY trip_count DESC, z.zone_name ASC;

-- Q07. Average ride fare by source.
SELECT TOP 5 t.source_system, AVG(p.amount) AS avg_ride_fare_eur
FROM trip t
JOIN payment p ON CAST(t.trip_id AS VARCHAR(100)) = p.service_id
WHERE p.status = 'succeeded'
  AND p.service_type = 'ride'
GROUP BY t.source_system
ORDER BY avg_ride_fare_eur DESC, t.source_system ASC;

-- Q08. Payment success rate by service.
SELECT TOP 5 
    CASE WHEN payment_correction_flag = 1 THEN 'package' ELSE service_type END AS service_type_corrected,
    COUNT(*) AS total_attempts,
    SUM(CASE WHEN status = 'succeeded' THEN 1 ELSE 0 END) AS successful_attempts,
    ROUND((SUM(CASE WHEN status = 'succeeded' THEN 1 ELSE 0 END) * 100.0) / COUNT(*), 2) AS success_rate_percent
FROM payment
GROUP BY CASE WHEN payment_correction_flag = 1 THEN 'package' ELSE service_type END
ORDER BY success_rate_percent DESC, service_type_corrected ASC;

-- Q09. Trip outcome breakdown.
SELECT TOP 10 
    CASE 
        WHEN TRIM(LOWER(status)) = 'finished' THEN 'completed'
        WHEN TRIM(LOWER(status)) = 'aborted' THEN 'cancelled_by_rider'
        WHEN TRIM(LOWER(status)) = 'noshow' THEN 'no_show'
        ELSE TRIM(LOWER(status))
    END AS status_normalized,
    COUNT(*) AS trip_count
FROM trip
GROUP BY 
    CASE 
        WHEN TRIM(LOWER(status)) = 'finished' THEN 'completed'
        WHEN TRIM(LOWER(status)) = 'aborted' THEN 'cancelled_by_rider'
        WHEN TRIM(LOWER(status)) = 'noshow' THEN 'no_show'
        ELSE TRIM(LOWER(status))
    END
ORDER BY status_normalized ASC;

-- Q10. Premium fare zones.
SELECT TOP 10 
    LOWER(REPLACE(TRIM(z.zone_name), '-', ' ')) AS zone_name_canonical,
    COUNT(*) AS completed_ride_count,
    AVG(p.amount) AS avg_fare_eur
FROM trip t
JOIN zone z ON t.pickup_zone_id = z.zone_id
JOIN payment p ON CAST(t.trip_id AS VARCHAR(100)) = p.service_id
WHERE p.status = 'succeeded'
  AND p.service_type = 'ride'
  AND TRIM(LOWER(t.status)) IN ('completed', 'finished')
GROUP BY LOWER(REPLACE(TRIM(z.zone_name), '-', ' '))
ORDER BY avg_fare_eur DESC, zone_name_canonical ASC;

-- Q11. Top-rated drivers leaderboard.
SELECT TOP 20 
    t.driver_id,
    d.driver_name,
    AVG(CASE WHEN r.source_system = 'quickhop' THEN r.score / 2.0 ELSE r.score END) AS avg_normalized_rating,
    COUNT(r.rating_id) AS rated_ride_count
FROM rating r
JOIN trip t ON r.service_id = CAST(t.trip_id AS VARCHAR(100))
JOIN driver d ON t.driver_id = d.driver_id
GROUP BY t.driver_id, d.driver_name
HAVING COUNT(r.rating_id) >= 30
ORDER BY avg_normalized_rating DESC, t.driver_id ASC;

-- Q12. Pending merge queue.
SELECT TOP 200 
    c1.customer_id AS goride_customer_id,
    c2.customer_id AS quickhop_customer_id,
    REPLACE(REPLACE(REPLACE(REPLACE(c1.phone, ' ', ''), '+', ''), '(', ''), ')', '') AS phone_normalized,
    c1.email
FROM customer c1
JOIN customer c2 ON REPLACE(REPLACE(REPLACE(REPLACE(c1.phone, ' ', ''), '+', ''), '(', ''), ')', '') = 
                    REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(c2.phone, ' ', ''), '+', ''), '(', ''), ')', ''), '490', '49')
WHERE c1.source_system = 'goride'
  AND c2.source_system = 'quickhop'
  AND c1.merged_into_customer_id IS NULL
  AND c2.merged_into_customer_id IS NULL
ORDER BY c1.email ASC, c1.customer_id ASC;

-- Q13. Parcel-heavy zones for ride cross-sell.
WITH zone_metrics AS (
    SELECT 
        LOWER(REPLACE(TRIM(z.zone_name), '-', ' ')) AS zone_name_canonical,
        COUNT(DISTINCT t.trip_id) AS ride_count,
        COUNT(DISTINCT pd.delivery_id) AS parcel_count
    FROM zone z
    LEFT JOIN trip t ON z.zone_id = t.pickup_zone_id
    LEFT JOIN package_delivery pd ON z.zone_id = pd.pickup_zone_id
    GROUP BY LOWER(REPLACE(TRIM(z.zone_name), '-', ' '))
)
SELECT TOP 25 
    zone_name_canonical, 
    ride_count, 
    parcel_count,
    ROUND((parcel_count * 100.0) / NULLIF((ride_count + parcel_count), 0), 2) AS parcel_share_percent
FROM zone_metrics
WHERE (parcel_count * 100.0) / NULLIF((ride_count + parcel_count), 0) > 18
ORDER BY parcel_share_percent DESC, zone_name_canonical ASC;

-- Q14. Advertising target zones.
SELECT TOP 25 
    LOWER(REPLACE(TRIM(z.zone_name), '-', ' ')) AS zone_name_canonical,
    COUNT(*) AS total_rides,
    SUM(CASE WHEN TRIM(LOWER(t.status)) IN ('cancelled_by_rider', 'cancelled_by_driver', 'aborted', 'no_show', 'noshow') THEN 1 ELSE 0 END) AS cancelled_rides,
    ROUND((SUM(CASE WHEN TRIM(LOWER(t.status)) IN ('cancelled_by_rider', 'cancelled_by_driver', 'aborted', 'no_show', 'noshow') THEN 1 ELSE 0 END) * 100.0) / COUNT(*), 2) AS cancellation_rate_percent
FROM trip t
JOIN zone z ON t.pickup_zone_id = z.zone_id
GROUP BY LOWER(REPLACE(TRIM(z.zone_name), '-', ' '))
HAVING (SUM(CASE WHEN TRIM(LOWER(t.status)) IN ('cancelled_by_rider', 'cancelled_by_driver', 'aborted', 'no_show', 'noshow') THEN 1 ELSE 0 END) * 100.0) / COUNT(*) > 25
   AND COUNT(*) < 1100
ORDER BY cancellation_rate_percent DESC, zone_name_canonical ASC;

-- Q15. Top revenue vehicles.
SELECT TOP 5 
    src.vehicle_id,
    v.license_plate,
    SUM(p.amount) AS total_revenue_eur
FROM (
    SELECT vehicle_id, CAST(trip_id AS VARCHAR(100)) AS service_str_id FROM trip
    UNION ALL
    SELECT vehicle_id, CAST(delivery_id AS VARCHAR(100)) AS service_str_id FROM package_delivery
) src
JOIN vehicle v ON src.vehicle_id = v.vehicle_id
JOIN payment p ON src.service_str_id = p.service_id
WHERE p.status = 'succeeded'
GROUP BY src.vehicle_id, v.license_plate
ORDER BY total_revenue_eur DESC, src.vehicle_id ASC;

-- Q16. Revenue mix for the board.
WITH unified_services AS (
    SELECT CAST(trip_id AS VARCHAR(100)) AS service_str_id, rider_customer_id AS context_customer_id FROM trip
    UNION ALL
    SELECT CAST(delivery_id AS VARCHAR(100)) AS service_str_id, sender_customer_id AS context_customer_id FROM package_delivery
)
SELECT TOP 25 
    c.source_system,
    CASE WHEN p.payment_correction_flag = 1 THEN 'package' ELSE p.service_type END AS service_type_corrected,
    c.customer_type,
    SUM(p.amount) AS total_revenue_eur
FROM payment p
JOIN unified_services us ON p.service_id = us.service_str_id
JOIN customer c ON us.context_customer_id = c.customer_id
WHERE p.status = 'succeeded'
GROUP BY 
    c.source_system, 
    CASE WHEN p.payment_correction_flag = 1 THEN 'package' ELSE p.service_type END, 
    c.customer_type
ORDER BY total_revenue_eur DESC, c.source_system ASC, service_type_corrected ASC, c.customer_type ASC;

-- Q17. Payment service-type reconciliation errors.
SELECT TOP 100 
    p.payment_id,
    p.service_type AS claimed_service_type,
    CASE WHEN p.service_type = 'ride' THEN 'package' ELSE 'ride' END AS actual_service_type,
    p.service_id
FROM payment p
WHERE (p.service_type = 'ride' AND NOT EXISTS (SELECT 1 FROM trip t WHERE CAST(t.trip_id AS VARCHAR(100)) = p.service_id))
   OR (p.service_type = 'package' AND NOT EXISTS (SELECT 1 FROM package_delivery pd WHERE CAST(pd.delivery_id AS VARCHAR(100)) = p.service_id))
ORDER BY p.payment_id ASC;

-- Q18. Lapsed customers for win-back.
WITH resolved_trips AS (
    SELECT 
        COALESCE(c.merged_into_customer_id, t.rider_customer_id) AS master_customer_id,
        CAST(t.requested_at AS DATE) AS ride_date
    FROM trip t
    JOIN customer c ON t.rider_customer_id = c.customer_id
    WHERE TRIM(LOWER(t.status)) IN ('completed', 'finished')
      AND c.customer_type = 'individual'
),
customer_aggregates AS (
    SELECT 
        master_customer_id,
        COUNT(*) AS total_completed_rides,
        MAX(ride_date) AS last_ride_date,
        DATEDIFF(day, MAX(ride_date), (SELECT MAX(ride_date) FROM resolved_trips)) AS days_since_last_ride
    FROM resolved_trips
    GROUP BY master_customer_id
    HAVING COUNT(*) >= 3
)
SELECT TOP 100 
    ca.master_customer_id,
    cust.email,
    ca.total_completed_rides,
    ca.last_ride_date,
    ca.days_since_last_ride
FROM customer_aggregates ca
JOIN customer cust ON ca.master_customer_id = cust.customer_id
WHERE ca.days_since_last_ride >= 60
ORDER BY ca.days_since_last_ride DESC, ca.master_customer_id ASC;

-- Q19. Berlin zones by average monthly rider spending.
SELECT TOP 25 
    LOWER(REPLACE(TRIM(z.zone_name), '-', ' ')) AS zone_name_canonical,
    COUNT(DISTINCT CONCAT(CAST(t.rider_customer_id AS VARCHAR(50)), FORMAT(t.requested_at, 'yyyy-MM'))) AS distinct_rider_months,
    SUM(p.amount) AS total_zone_spend_eur,
    ROUND(SUM(p.amount) / COUNT(DISTINCT CONCAT(CAST(t.rider_customer_id AS VARCHAR(50)), FORMAT(t.requested_at, 'yyyy-MM'))), 2) AS avg_spending_per_rider_per_month_eur
FROM trip t
JOIN zone z ON t.pickup_zone_id = z.zone_id
JOIN payment p ON CAST(t.trip_id AS VARCHAR(100)) = p.service_id
WHERE p.status = 'succeeded'
  AND (CASE WHEN p.payment_correction_flag = 1 THEN 'package' ELSE p.service_type END) = 'ride'
GROUP BY LOWER(REPLACE(TRIM(z.zone_name), '-', ' '))
ORDER BY avg_spending_per_rider_per_month_eur DESC, zone_name_canonical ASC;

-- Q20. Top earners by average monthly revenue.
WITH driver_revenue AS (
    SELECT 
        COALESCE(d.merged_into_driver_id, t.driver_id) AS master_driver_id,
        FORMAT(t.requested_at, 'yyyy-MM') AS cal_month,
        p.amount
    FROM trip t
    JOIN driver d ON t.driver_id = d.driver_id
    JOIN payment p ON CAST(t.trip_id AS VARCHAR(100)) = p.service_id
    WHERE p.status = 'succeeded'
    UNION ALL
    SELECT 
        COALESCE(d.merged_into_driver_id, pd.driver_id) AS master_driver_id,
        FORMAT(pd.requested_at, 'yyyy-MM') AS cal_month,
        p.amount
    FROM package_delivery pd
    JOIN driver d ON pd.driver_id = d.driver_id
    JOIN payment p ON CAST(pd.delivery_id AS VARCHAR(100)) = p.service_id
    WHERE p.status = 'succeeded'
),
active_months_count AS (
    SELECT 
        COALESCE(d.merged_into_driver_id, t.driver_id) AS master_driver_id,
        COUNT(DISTINCT FORMAT(t.requested_at, 'yyyy-MM')) AS active_months
    FROM trip t
    JOIN driver d ON t.driver_id = d.driver_id
    WHERE TRIM(LOWER(t.status)) IN ('completed', 'finished')
    GROUP BY COALESCE(d.merged_into_driver_id, t.driver_id)
)
SELECT TOP 20 
    dr.master_driver_id,
    drv.driver_name,
    am.active_months,
    SUM(dr.amount) AS total_revenue_eur,
    ROUND(SUM(dr.amount) / am.active_months, 2) AS avg_monthly_revenue_eur
FROM driver_revenue dr
JOIN driver drv ON dr.master_driver_id = drv.driver_id
JOIN active_months_count am ON dr.master_driver_id = am.master_driver_id
GROUP BY dr.master_driver_id, drv.driver_name, am.active_months
ORDER BY avg_monthly_revenue_eur DESC, dr.master_driver_id ASC;

-- Q21. Refund-impact on revenue.
WITH service_source_mapping AS (
    SELECT CAST(trip_id AS VARCHAR(100)) AS service_str_id, source_system FROM trip
    UNION ALL
    SELECT CAST(delivery_id AS VARCHAR(100)) AS service_str_id, 'goride' AS source_system FROM package_delivery
)
SELECT TOP 25 
    ssm.source_system,
    CASE WHEN p.payment_correction_flag = 1 THEN 'package' ELSE p.service_type END AS service_type_corrected,
    SUM(CASE WHEN p.status = 'succeeded' THEN p.amount ELSE 0 END) AS collected_revenue_eur,
    SUM(CASE WHEN p.status = 'refunded' THEN p.amount ELSE 0 END) AS refunded_revenue_eur,
    SUM(CASE WHEN p.status = 'succeeded' THEN p.amount ELSE 0 END) - SUM(CASE WHEN p.status = 'refunded' THEN p.amount ELSE 0 END) AS net_revenue_eur
FROM payment p
JOIN service_source_mapping ssm ON p.service_id = ssm.service_str_id
GROUP BY ssm.source_system, CASE WHEN p.payment_correction_flag = 1 THEN 'package' ELSE p.service_type END
ORDER BY net_revenue_eur DESC, ssm.source_system ASC, service_type_corrected ASC;

-- Q22. Top businesses by average monthly spend.
SELECT TOP 20 
    pd.sender_customer_id AS customer_id,
    c.business_name,
    COUNT(DISTINCT FORMAT(pd.requested_at, 'yyyy-MM')) AS active_months,
    SUM(p.amount) AS total_spend_eur,
    ROUND(SUM(p.amount) / COUNT(DISTINCT FORMAT(pd.requested_at, 'yyyy-MM')), 2) AS avg_monthly_spend_eur
FROM package_delivery pd
JOIN customer c ON pd.sender_customer_id = c.customer_id
JOIN payment p ON CAST(pd.delivery_id AS VARCHAR(100)) = p.service_id
WHERE c.customer_type = 'business'
  AND p.status = 'succeeded'
GROUP BY pd.sender_customer_id, c.business_name
ORDER BY avg_monthly_spend_eur DESC, customer_id ASC;

-- Q23. Fraud detection: cancelled trips with kept payments.
SELECT TOP 50 
    t.trip_id,
    t.source_system,
    t.status AS trip_status,
    p.payment_id,
    p.amount AS payment_amount_eur
FROM trip t
JOIN payment p ON CAST(t.trip_id AS VARCHAR(100)) = p.service_id
WHERE TRIM(LOWER(t.status)) IN ('cancelled_by_rider', 'cancelled_by_driver', 'aborted', 'no_show', 'noshow')
  AND p.status = 'succeeded'
  AND NOT EXISTS (
      SELECT 1 FROM payment p2 
      WHERE p2.service_id = p.service_id 
        AND p2.status = 'refunded'
  )
ORDER BY payment_amount_eur DESC, t.trip_id ASC;

-- Q24. Ghost trips audit.
SELECT TOP 50 
    t.trip_id,
    t.source_system,
    t.driver_id,
    t.vehicle_id,
    CAST(t.requested_at AS DATE) AS trip_date
FROM trip t
WHERE TRIM(LOWER(t.status)) IN ('completed', 'finished')
  AND NOT EXISTS (
      SELECT 1 
      FROM driver_vehicle_assignment dva
      WHERE dva.driver_id = t.driver_id
        AND dva.vehicle_id = t.vehicle_id
        AND t.requested_at >= dva.valid_from
        AND (dva.valid_to IS NULL OR t.requested_at <= dva.valid_to)
  )
ORDER BY trip_date DESC, t.trip_id ASC;

-- Q25. Berlin zones by average monthly driver earnings.
SELECT TOP 25 
    LOWER(REPLACE(TRIM(z.zone_name), '-', ' ')) AS zone_name_canonical,
    COUNT(DISTINCT CONCAT(CAST(COALESCE(d.merged_into_driver_id, t.driver_id) AS VARCHAR(50)), FORMAT(t.requested_at, 'yyyy-MM'))) AS qualifying_driver_months,
    SUM(p.amount) AS total_zone_revenue_eur,
    ROUND(SUM(p.amount) / COUNT(DISTINCT CONCAT(CAST(COALESCE(d.merged_into_driver_id, t.driver_id) AS VARCHAR(50)), FORMAT(t.requested_at, 'yyyy-MM'))), 2) AS avg_revenue_per_driver_per_month_eur
FROM trip t
JOIN zone z ON t.pickup_zone_id = z.zone_id
JOIN driver d ON t.driver_id = d.driver_id
JOIN payment p ON CAST(t.trip_id AS VARCHAR(100)) = p.service_id
WHERE p.status = 'succeeded'
  AND (CASE WHEN p.payment_correction_flag = 1 THEN 'package' ELSE p.service_type END) = 'ride'
GROUP BY LOWER(REPLACE(TRIM(z.zone_name), '-', ' '))
ORDER BY avg_revenue_per_driver_per_month_eur DESC, zone_name_canonical ASC;
